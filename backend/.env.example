# =============================================================
# VIBE OF MADEENA 2K26 — Environment Variables Configuration
# =============================================================

# PostgreSQL Connection String (Render / Supabase / Neon / Local PostgreSQL)
# Example: postgresql://postgres:yourpassword@localhost:5432/vibe_of_madeena
DATABASE_URL=your_postgresql_connection_string_here

# JWT Secret Key for Authentication Tokens
JWT_SECRET=your_jwt_secret_key_here

# Server Port
PORT=5000

# Frontend URL (For Production CORS restriction)
FRONTEND_URL=https://vibe-of-madeena.vercel.app
